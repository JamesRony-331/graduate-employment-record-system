<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wzbc.EmploymentServer.Mapper.SysRoleMapper">
    <resultMap id="RoleResultMap" type="com.wzbc.EmploymentServer.entity.PO.SysRolePO">
        <id column="id" property="id"/>
        <result column="role_name" property="roleName"/>
        <result column="role_code" property="roleCode"/>
        <result column="status" property="status"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="remark" property="remark"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>
    <sql id="Columns">id, role_name, role_code, status, sort_order, remark, created_at, updated_at</sql>
    <select id="selectById" resultMap="RoleResultMap">
        SELECT <include refid="Columns"/> FROM sys_role WHERE id = #{id}
    </select>
    <select id="selectByIdForUpdate" resultMap="RoleResultMap">
        SELECT <include refid="Columns"/> FROM sys_role WHERE id = #{id} FOR UPDATE
    </select>
    <select id="selectByCode" resultMap="RoleResultMap">
        SELECT <include refid="Columns"/> FROM sys_role WHERE role_code = #{roleCode}
    </select>
    <select id="selectAll" resultMap="RoleResultMap">
        SELECT <include refid="Columns"/> FROM sys_role ORDER BY sort_order, id
    </select>
    <select id="selectByPage" resultMap="RoleResultMap">
        SELECT <include refid="Columns"/> FROM sys_role ORDER BY sort_order, id
        LIMIT #{pageQuery.pageSize} OFFSET #{pageQuery.start}
    </select>
    <select id="selectCount" resultType="int">SELECT COUNT(*) FROM sys_role</select>
    <insert id="insert" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO sys_role (role_name, role_code, status, sort_order, remark)
        VALUES (#{roleName}, #{roleCode}, COALESCE(#{status}, 1), COALESCE(#{sortOrder}, 0), #{remark})
    </insert>
    <update id="update">
        UPDATE sys_role
        <set>
            <if test="roleName != null">role_name = #{roleName},</if>
            <if test="roleCode != null">role_code = #{roleCode},</if>
            <if test="status != null">status = #{status},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="remark != null">remark = #{remark},</if>
            updated_at = CURRENT_TIMESTAMP(3)
        </set>
        WHERE id = #{id}
    </update>
    <delete id="deleteById">DELETE FROM sys_role WHERE id = #{id}</delete>
</mapper>
